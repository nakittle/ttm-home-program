# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (region: Singapore). Without these the app uses an in-memory store (data is lost on restart).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32+ random characters, signs the clinic session cookie
SESSION_SECRET=

# Enables POST /api/demo/reset, which re-creates the seeded demo plans (leave empty to disable)
DEMO_RESET_TOKEN=
# PIN for the demo clinics DEMO-A / DEMO-B / DEMO-C when the seed creates them (6 digits; choose your own, never commit it)
DEMO_CLINIC_PIN=
# Demo plans on printed QR codes (comma list, default TCX-86): "delete my data" keeps them open, seed --reset refuses while they exist
# PROTECTED_PLAN_CODES=TCX-86

# Only on your machine, for npm run tts (not needed on Vercel)
GEMINI_API_KEY=
GEMINI_TTS_MODEL=

# Local `npm run build && next start` only: allow the in-memory store (data lost on restart) when Supabase is not set.
# Never set this on Vercel: there a missing Supabase config should fail loudly.
# ALLOW_MEMORY_STORE=1
